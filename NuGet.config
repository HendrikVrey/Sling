<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sling depends on one package that is not public: Etch.Core, the transform engine
    from https://github.com/HendrikVrey/Etch. Everything else comes from nuget.org.

    WHY IT IS PRIVATE. Etch is source-available, not open source, and its licence
    §3(b) forbids making any part of the Software available to a third party. A
    package on nuget.org would do exactly that — every consumer's build output embeds
    Etch.Core.dll — so publishing one would ship something nobody is licensed to use.
    The full reasoning is in docs/etch-core-package.md.

    TWO SOURCES CAN SUPPLY IT.

      local-feed  A folder in this repository. The offline fallback, and what a
                  machine without GitHub Packages credentials restores from. See
                  local-feed/README.md for how to fill it.

      etch-github GitHub Packages, the canonical feed. Requires authentication; the
                  `dotnet nuget update source etch-github` command in
                  docs/etch-core-package.md writes the credentials into your
                  user-level NuGet.config, never into this file.

    Both are listed for Etch.* so that a machine with either one can build. Do NOT
    put credentials in this file — it is committed.
  -->

  <packageSources>
    <!--
      Cleared first, deliberately. Without this, whatever sources happen to be in the
      machine's user-level or global config are appended to these, which is how a
      build becomes reproducible on one machine and not another.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-feed" value="local-feed" />
    <add key="etch-github" value="https://nuget.pkg.github.com/HendrikVrey/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping, and it is a security control rather than tidiness.

    `Etch.Core` is unclaimed on nuget.org. Without a mapping, anyone could register
    that id publicly and the next restore on a machine that had not yet cached the
    real one would silently pull theirs instead — dependency confusion, and the
    package would be executing inside a tool that handles bearer tokens. The mapping
    means the id is only ever resolved from the two sources that are allowed to
    answer for it, and nuget.org is never asked.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="Etch.*" />
    </packageSource>
    <packageSource key="etch-github">
      <package pattern="Etch.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
