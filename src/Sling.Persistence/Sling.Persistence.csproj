<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sling.Persistence owns all disk I/O: workspace files, environments, the
    gitignored secrets file, local history, and settings.

    No UI. Keeping every file-system call in one project is what lets the
    "secrets never land in a committed file" rule be checked by reading one project
    rather than the whole solution.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sling.Persistence</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sling.Core\Sling.Core.csproj" />
    <!--
      ImportStore puts the files a Postman import produced on disk. The importer is
      pure by design, so somebody has to own that write, and this is the project that
      owns writes - doing it from Sling.App instead would put file-system calls in the
      UI and break the property that makes the secrets rule checkable by reading one
      project.
    -->
    <ProjectReference Include="..\Sling.Import\Sling.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DPAPI, for the token store. Windows' own data protection rather than a key Sling
      invents and then has to keep somewhere: the encryption is bound to the user's account
      by the operating system, which is the one thing an application cannot do for itself.

      A package rather than the shared framework, because System.Security.Cryptography.
      ProtectedData is Windows-only and .NET does not carry it in the box. This project
      targets net10.0 rather than net10.0-windows, so the package is what supplies it.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sling.Persistence.Tests" />
  </ItemGroup>

</Project>
