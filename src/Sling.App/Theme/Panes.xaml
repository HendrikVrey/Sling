<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">

    <!--
        Design tokens for the two editor panes.

        Colours are DynamicResource lookups into WPF-UI's theme dictionary rather than
        literals, so a later light/dark switch costs nothing. AvalonEdit does not theme
        itself - it is a plain WPF Control and will render black-on-white unless told
        otherwise - so every colour it uses has to be set here explicitly.
    -->

    <!-- One spacing value, used everywhere a pane needs internal breathing room. -->
    <Thickness x:Key="PanePadding">10</Thickness>

    <Style x:Key="PaneBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--
        The label above a pane: COLLECTIONS, the open file's name, RESPONSE. One style
        rather than four copies of the same three attributes, because they are one role and
        a header that drifts out of step with its neighbour is the kind of thing nobody
        reports and everybody sees.
    -->
    <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        A modal card, and it is deliberately NOT PaneBorderStyle - which is the bug this
        style exists to fix.

        CardBackgroundFillColorDefaultBrush is #0DFFFFFF: five per cent white, which is
        exactly right for a pane sitting on the window's own Mica backdrop and exactly
        wrong for a card floating over a scrim. The settings panel and the name prompt were
        both 95% transparent, so what showed through them was the darkened window behind,
        they read as faded, half-rendered and broken. A dialog needs an opaque surface of
        its own, and WPF-UI ships the one WinUI uses for exactly this: ContentDialog's.
    -->
    <Style x:Key="DialogCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentDialogBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ContentDialogBackground}" />
        <Setter Property="Effect">
            <Setter.Value>
                <!--
                    Shared by both overlays, and safe to share: a Freezable used read-only.
                    The shadow is what separates the card from the scrim - without it an
                    opaque panel on a dark wash reads as a region of the window rather than
                    as something on top of it.
                -->
                <DropShadowEffect BlurRadius="32"
                                  Direction="270"
                                  Opacity="0.5"
                                  ShadowDepth="8"
                                  Color="#FF000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The wash behind a modal card. Darker than WinUI's SmokeFillColorDefault (#4D000000)
        on purpose: Sling's own surface is already near-black, and a 30% wash over it does
        not read as "the window behind is inactive".
    -->
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#000000" Opacity="0.62" />

    <!--
        The status pill beside the RESPONSE label. Only the geometry lives here - every
        colour on it is computed against the pane at runtime by StatusPalette, because a
        colour written into a style is a colour nothing can hold to a contrast floor.
    -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The hairline between two groups of toolbar buttons. -->
    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,5,10,5" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!--
        The settings overlay's two text roles. Styles rather than attributes repeated on
        each element, so the spacing between a label and the control under it is one
        number in one place - that overlay is the only screen in Sling with a vertical
        rhythm to keep, and it has eight of them.
    -->
    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,16,0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaneEditorStyle" TargetType="{x:Type avalon:TextEditor}">
        <!--
            Cascadia Code first, Consolas as the fallback that exists on every Windows
            install. WPF resolves a FontFamily list left to right per glyph, so this is
            a real fallback chain rather than a guess about what is installed.
        -->
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="{StaticResource PanePadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="LineNumbersForeground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="WordWrap" Value="True" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
