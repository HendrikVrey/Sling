<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">

    <!--
        Design tokens for the two editor panes.

        Colours are DynamicResource lookups into WPF-UI's theme dictionary rather than
        literals, so a later light/dark switch costs nothing. AvalonEdit does not theme
        itself — it is a plain WPF Control and will render black-on-white unless told
        otherwise — so every colour it uses has to be set here explicitly.
    -->

    <!-- One spacing value, used everywhere a pane needs internal breathing room. -->
    <Thickness x:Key="PanePadding">10</Thickness>

    <Style x:Key="PaneBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--
        The settings overlay's two text roles. Styles rather than attributes repeated on
        each element, so the spacing between a label and the control under it is one
        number in one place — that overlay is the only screen in Sling with a vertical
        rhythm to keep, and it has eight of them.
    -->
    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,16,0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaneEditorStyle" TargetType="{x:Type avalon:TextEditor}">
        <!--
            Cascadia Code first, Consolas as the fallback that exists on every Windows
            install. WPF resolves a FontFamily list left to right per glyph, so this is
            a real fallback chain rather than a guess about what is installed.
        -->
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="{StaticResource PanePadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="LineNumbersForeground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="WordWrap" Value="True" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
