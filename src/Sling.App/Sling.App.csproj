<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WPF shell. No business logic lives here: parsing belongs in Sling.Core,
    sending in Sling.Http, disk in Sling.Persistence.

    Unlike Etch, Sling does NOT take over its own entry point. Etch owns Main so its
    startup timeline can take a measurement before the Application object is
    constructed; Sling has no measurement gate (Sling.md §6), so the standard
    ApplicationDefinition is used and the NETSDK1022 trap that comes with overriding
    it is avoided entirely.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sling.App</RootNamespace>
    <AssemblyName>Sling</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Label="Publish">
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Single-file compression decompresses on every launch. Sling sells being light,
      so this stays off.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!--
      WPF is not trim-friendly: XAML resolves types by reflection, so trimming breaks
      it in ways that only surface at runtime. NativeAOT is not available for WPF.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="AvalonEdit" />
    <!--
      Sling.md §3: the response buffer runs Etch's transform chain, and Sling.App is
      where that lands. It goes here rather than in Sling.Core because the buffer is a
      UI object — highlighting, folding and the palette are editor concerns — and
      because ArchitectureTests holds Sling.Core to zero package references. Etch.Core
      would qualify on merit (pure, no dependencies, no I/O), but the rule is a bright
      line and this dependency does not need it moved.

      Private feed, no credentials required for a local build. See NuGet.config.
    -->
    <PackageReference Include="Etch.Core" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The palette's legibility promise and the body-language rule are decidable without
      a window, and both are internal because nothing outside this assembly should be
      calling them. Note that this grants access, not accessibility: a public xUnit
      [Theory] still cannot take an internal enum as a parameter (CS0051), so the
      table-driven palette tests hold their tables in the body of a [Fact].
    -->
    <InternalsVisibleTo Include="Sling.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sling.Core\Sling.Core.csproj" />
    <ProjectReference Include="..\Sling.Import\Sling.Import.csproj" />
    <ProjectReference Include="..\Sling.Http\Sling.Http.csproj" />
    <ProjectReference Include="..\Sling.Persistence\Sling.Persistence.csproj" />
  </ItemGroup>

</Project>
