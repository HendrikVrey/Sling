<Application x:Class="Sling.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    WPF-UI's theme dictionaries are the main XAML cost at startup.
                    Merge these two and nothing else.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Theme/Panes.xaml" />
                <!--
                    AvalonEdit's find bar, retemplated. It belongs here rather than on the
                    window because SearchPanel.Install builds the panel itself and hands it
                    to an adorner layer, so there is no element in this application's markup
                    to carry a local style.
                -->
                <ResourceDictionary Source="Theme/FindBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
