<ui:FluentWindow x:Class="Sling.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
                 Title="Sling"
                 Width="1180"
                 Height="760"
                 MinWidth="520"
                 MinHeight="360"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <!--
        The chrome's control styles live here rather than in Theme/Panes.xaml, and the
        reason is a WPF rule rather than a preference: a StaticResource inside a dictionary
        loaded by Source cannot see a sibling dictionary merged beside it, so a style that
        wants BasedOn="{StaticResource {x:Type ui:Button}}" has to sit somewhere that can
        walk up to Application.Resources. Panes.xaml keeps the colour and geometry tokens,
        which use DynamicResource and have no such problem.
    -->
    <ui:FluentWindow.Resources>
        <Style x:Key="ToolbarButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="ui:Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Icon only, so the padding is square rather than a label's. -->
        <Style x:Key="ToolbarIconButtonStyle"
               BasedOn="{StaticResource ToolbarButtonStyle}"
               TargetType="ui:Button">
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style x:Key="ToolbarMenuButtonStyle"
               BasedOn="{StaticResource {x:Type ui:DropDownButton}}"
               TargetType="ui:DropDownButton">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            The rail's creation buttons. Stretched and centred so three of them read as one
            control strip rather than as three things that happen to be next to each other.
        -->
        <Style x:Key="RailActionButtonStyle"
               BasedOn="{StaticResource {x:Type ui:Button}}"
               TargetType="ui:Button">
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The window's Title carries the open file and its dirty marker; one source. -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

        <!--
            The command bar.

            Every action here already had a chord and nothing else, which is a keymap rather
            than an interface: a command nobody can see is a command nobody finds. Each
            button names its own shortcut in its tooltip and every item in the File menu
            carries its gesture, so the toolbar teaches the keyboard instead of replacing it.

            DockPanel for the reason the status bar and the rail are DockPanels: WPF never
            compresses an Auto region, so a toolbar built from Auto columns pushes its
            right-hand end off screen at narrow widths. Declaration order is priority order,
            which is why Settings and History are declared first - they are the two that must
            survive - and the send target, which is a label and can trim, is the fill child.
        -->
        <DockPanel Grid.Row="1"
                   Margin="12,2,12,10"
                   LastChildFill="True">
            <ui:Button x:Name="SettingsButton"
                       Margin="0"
                       DockPanel.Dock="Right"
                       Click="OnSettingsClicked"
                       Icon="{ui:SymbolIcon Settings24}"
                       Style="{StaticResource ToolbarIconButtonStyle}"
                       ToolTip="Settings  (Ctrl+,)" />

            <ui:Button x:Name="HistoryButton"
                       DockPanel.Dock="Right"
                       Click="OnHistoryClicked"
                       Icon="{ui:SymbolIcon History24}"
                       Style="{StaticResource ToolbarIconButtonStyle}"
                       ToolTip="What has been sent, with credentials removed  (Ctrl+H)" />

            <!--
                Hiding the rail, which at 250 px is half the window on a narrow one. The
                panes have a 160 px minimum each, so below roughly 620 px of client width
                the response pane starts being clipped no matter how the space is divided,
                and until now the only way out was to widen the window. One button gives the
                whole width back.
            -->
            <ui:Button x:Name="RailToggleButton"
                       DockPanel.Dock="Left"
                       Click="OnToggleRail"
                       Icon="{ui:SymbolIcon PanelLeftContract24}"
                       Style="{StaticResource ToolbarIconButtonStyle}"
                       ToolTip="Hide the collections rail  (Ctrl+B)" />

            <!--
                Send is the application, and it is the only Primary control on this bar. It
                turns into Cancel for the duration of a request rather than sitting there
                disabled. Escape already cancels, and a button that does nothing while the
                thing it started is running is a button that has to be explained.

                MinWidth because "Cancel" is wider than "Send": without it the whole left
                group shuffles sideways every time a request starts, which is movement under
                a cursor that is on its way to the button.
            -->
            <ui:Button x:Name="SendButton"
                       MinWidth="92"
                       DockPanel.Dock="Left"
                       Appearance="Primary"
                       Click="OnSendClicked"
                       Content="Send"
                       Icon="{ui:SymbolIcon Send24}"
                       Style="{StaticResource ToolbarButtonStyle}"
                       ToolTip="Send the request under the caret  (Ctrl+Enter)" />

            <ui:Button x:Name="RunAllButton"
                       DockPanel.Dock="Left"
                       Click="OnRunAllClicked"
                       Content="Run all"
                       Icon="{ui:SymbolIcon FastForward24}"
                       Style="{StaticResource ToolbarButtonStyle}"
                       ToolTip="Send every request in this file, top to bottom  (Ctrl+Shift+Enter)" />

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

            <!--
                One visible button that reveals every document command with the key that
                also runs it. A menu rather than eight more buttons: these are the commands
                somebody reaches for a few times a session, and a toolbar that shows all of
                them equally says none of them matter more than Send.
            -->
            <ui:DropDownButton x:Name="FileMenuButton"
                               DockPanel.Dock="Left"
                               Content="File"
                               Icon="{ui:SymbolIcon Document24}"
                               Style="{StaticResource ToolbarMenuButtonStyle}"
                               ToolTip="Open, create, save and import">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Click="OnOpenFolderClicked"
                                  Header="Open folder…"
                                  InputGestureText="Ctrl+Shift+O" />
                        <MenuItem Click="OnOpenDocumentClicked"
                                  Header="Open file…"
                                  InputGestureText="Ctrl+O" />
                        <Separator />
                        <MenuItem Click="OnNewCollection" Header="New collection…" />
                        <MenuItem Click="OnNewDocument" Header="New request file…" />
                        <MenuItem Click="OnNewRequest"
                                  Header="New request in this file"
                                  InputGestureText="Ctrl+Shift+N" />
                        <MenuItem Click="OnNewEmptyDocumentClicked"
                                  Header="New empty document"
                                  InputGestureText="Ctrl+N" />
                        <Separator />
                        <MenuItem Click="OnSaveClicked"
                                  Header="Save"
                                  InputGestureText="Ctrl+S" />
                        <MenuItem Click="OnSaveAsClicked"
                                  Header="Save as…"
                                  InputGestureText="Ctrl+Shift+S" />
                        <Separator />
                        <MenuItem Click="OnImportClicked"
                                  Header="Import from Postman…"
                                  InputGestureText="Ctrl+I" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>

            <!--
                Save has its own button despite being in the menu above. It is the one
                command in that list with a state - there are unsaved changes or there are
                not - and a disabled button is the cheapest possible answer to "did that
                save?".
            -->
            <ui:Button x:Name="SaveButton"
                       DockPanel.Dock="Left"
                       Click="OnSaveClicked"
                       Content="Save"
                       Icon="{ui:SymbolIcon Save24}"
                       Style="{StaticResource ToolbarButtonStyle}"
                       ToolTip="Write this file to disk  (Ctrl+S)" />

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />

            <!--
                What Send would send. The rail already highlights the row, but the rail is
                only there when a folder is open - and the question "which of these is about
                to go out" is the one this application must never leave ambiguous.
            -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SendTargetMethod"
                           Grid.Column="0"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="11"
                           FontWeight="Bold" />

                <TextBlock x:Name="SendTargetLabel"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.5"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DockPanel>

        <!--
            DockPanel, not a fourth Grid column. WPF never compresses an Auto column, so a
            file rail in one would push the response pane off screen at narrow widths,
            the bug Etch shipped in its status bar and had to rebuild. A DockPanel gives
            its fill child the remainder clamped at zero instead, so the rail takes its
            width and the panes shrink.
        -->
        <DockPanel Grid.Row="2" Margin="12,0,12,8" LastChildFill="True">
            <!--
                The collections rail: the folders and .http files in the workspace, and the
                requests inside them.

                A collection is a folder and an endpoint is a '###' block - no index, no
                metadata, nothing for Sling to own. Sling.md §1 has not changed; what this
                adds is a way to see the structure that was always on disk.

                ALWAYS VISIBLE, and that is a correction. It used to appear only once a
                folder was open, on the grounds that an empty box explains nothing - but a
                panel that is absent explains even less. On first run the whole feature was
                invisible and the way to reach it was a chord nobody had been told about.
                The empty state below is the explanation the collapsed rail was missing.
            -->
            <DockPanel x:Name="FilesRail"
                       Width="250"
                       Margin="0,0,10,0"
                       DockPanel.Dock="Left">
                <TextBlock x:Name="FilesLabel"
                           Margin="2,0,0,6"
                           DockPanel.Dock="Top"
                           Style="{StaticResource PaneHeaderStyle}"
                           Text="COLLECTIONS" />

                <!--
                    All three creations, side by side and the same width. A rail whose only
                    way to add something is a right-click is a rail people believe is
                    read-only - and "New request file" used to be reachable *only* by
                    right-clicking, which is the least discoverable affordance there is.
                -->
                <UniformGrid x:Name="RailActions"
                             Margin="0,0,0,8"
                             Columns="3"
                             DockPanel.Dock="Top"
                             Visibility="Collapsed">
                    <ui:Button Margin="0,0,3,0"
                               Click="OnNewCollection"
                               Content="+ Collection"
                               Style="{StaticResource RailActionButtonStyle}"
                               ToolTip="Create a folder with a request file in it" />
                    <ui:Button Margin="3,0,3,0"
                               Click="OnNewDocument"
                               Content="+ File"
                               Style="{StaticResource RailActionButtonStyle}"
                               ToolTip="Create a .http file in whatever is selected" />
                    <ui:Button Margin="3,0,0,0"
                               Click="OnNewRequest"
                               Content="+ Request"
                               Style="{StaticResource RailActionButtonStyle}"
                               ToolTip="Append a request to the file that is open  (Ctrl+Shift+N)" />
                </UniformGrid>

                <Border Style="{StaticResource PaneBorderStyle}">
                    <Grid>
                        <!--
                            What the rail says before there is anything in it. It names the
                            concept, says what a collection actually is - because that is the
                            one thing somebody arriving from Postman will get wrong - and gives
                            them the button rather than a chord to discover.
                        -->
                        <StackPanel x:Name="EmptyRail"
                                    Margin="14,18,14,14"
                                    VerticalAlignment="Top">
                            <TextBlock FontSize="12"
                                       Opacity="0.75"
                                       Text="No folder open"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="11"
                                       Opacity="0.45"
                                       Text="A collection is a folder of .http files. Open one and it appears here, with the requests inside each file."
                                       TextWrapping="Wrap" />
                            <ui:Button Margin="0,14,0,0"
                                       Appearance="Primary"
                                       Click="OnOpenFolderClicked"
                                       Content="Open a folder"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Style="{StaticResource RailActionButtonStyle}" />
                            <ui:Button Margin="0,6,0,0"
                                       Click="OnImportClicked"
                                       Content="Import from Postman"
                                       Icon="{ui:SymbolIcon ArrowImport24}"
                                       Style="{StaticResource RailActionButtonStyle}" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Opacity="0.4"
                                       Text="Ctrl+Shift+O  ·  Ctrl+I" />
                        </StackPanel>

                        <TreeView x:Name="CollectionsTree"
                                  Padding="4"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="12"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectedItemChanged="OnCollectionSelected"
                                  Visibility="Collapsed">
                            <TreeView.ItemContainerStyle>
                                <!--
                                    Expansion and selection are driven from code as well as by
                                    clicking - opening a file has to reveal and select its row -
                                    so both are bound rather than reached through the container,
                                    which for a collapsed branch does not exist yet.
                                -->
                                <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <!--
                                        DockPanel, and it is what makes a long label trim
                                        rather than get cut. A horizontal StackPanel measures
                                        every child with infinite width, so TextTrimming can
                                        never fire inside one - the label's desired width is
                                        the whole string, and what the rail drew was that
                                        string chopped mid-word at the pane edge with no
                                        ellipsis to say so. Disabling the tree's horizontal
                                        scrollbar is what makes the row finite; it stopped one
                                        level short of the text.
                                    -->
                                    <DockPanel ToolTip="{Binding Hint}">
                                        <!--
                                            The verb, colour-coded. It is the one thing about
                                            Postman's tree that is genuinely good: DELETE does
                                            not look like GET, so the shape of a collection is
                                            legible without reading it. Every colour is held to
                                            the same contrast floor as the response pane - see
                                            MethodPalette.
                                        -->
                                        <TextBlock Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left"
                                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding MethodBrush}"
                                                   Text="{Binding Method}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRequest}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Label}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <!--
                                                            Weight carries depth, so the level a
                                                            row sits at is readable without
                                                            counting indents: a collection is the
                                                            heading, a file is the label, a
                                                            request is the content.
                                                        -->
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>

                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnNewCollection" Header="New collection…" />
                                    <MenuItem Click="OnNewDocument" Header="New request file…" />
                                    <MenuItem Click="OnNewRequest"
                                              Header="New request…"
                                              InputGestureText="Ctrl+Shift+N" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </Grid>
                </Border>
            </DockPanel>

            <!--
                Two panes: the request document on the left, the response on the right.
                A GridSplitter rather than a fixed ratio - a response is usually wider
                than the request that produced it, and the split people want depends on
                the API, not on a designer's guess.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <!--
                        The label names the open file, and the environment picker sits
                        beside it: which environment is selected changes what every
                        {{variable}} in this document resolves to, so it belongs against
                        the document rather than in a menu.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="RequestLabel"
                                   Grid.Column="0"
                                   Style="{StaticResource PaneHeaderStyle}"
                                   Text="REQUEST" />

                        <!--
                            What credential this request is actually sending, and where it
                            came from. Answering that used to mean reading three files: the
                            document, one environment file and the other one.
                        -->
                        <ui:Button x:Name="AuthButton"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Padding="8,2"
                                   Click="OnAuthClicked"
                                   Content="Auth"
                                   FontSize="11"
                                   ToolTip="The auth this request is sending  (Ctrl+Alt+A)" />

                        <ComboBox x:Name="EnvironmentPicker"
                                  Grid.Column="2"
                                  Margin="8,0,0,0"
                                  Padding="8,2"
                                  FontSize="12"
                                  SelectionChanged="OnEnvironmentSelected"
                                  Visibility="Collapsed" />

                        <!--
                            What token is in force. Tokens are cached by grant and dropped on
                            an environment switch - correct, and until now entirely
                            unobservable, so a 401 could not distinguish a stale token from a
                            wrong scope from a token fetched against the other environment.

                            The grant and the clock, never a token value: those are what
                            answer "why did that 401", and a panel is a place a screenshot
                            comes from.
                        -->
                        <ui:HyperlinkButton x:Name="TokenChip"
                                            Grid.Column="3"
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            Click="OnTokenChipClicked"
                                            FontSize="11"
                                            Visibility="Collapsed" />

                        <!--
                            Beside the picker, because the picker is where somebody looks
                            when a {{variable}} did not resolve. Visible whenever a folder is
                            open rather than only when environments exist: the case that
                            matters most is the one where there are none yet, and a button
                            that appears only after the file it creates exists is no use to
                            the person who has never had one.
                        -->
                        <ui:Button x:Name="EnvironmentsButton"
                                   Grid.Column="4"
                                   Margin="8,0,0,0"
                                   Padding="8,2"
                                   Click="OnEnvironmentsClicked"
                                   Content="Edit"
                                   FontSize="11"
                                   ToolTip="Environments and secrets  (Ctrl+E)" />
                    </Grid>

                    <Border Style="{StaticResource PaneBorderStyle}">
                        <Grid>
                            <avalon:TextEditor x:Name="RequestPane"
                                               ShowLineNumbers="True"
                                               Style="{StaticResource PaneEditorStyle}" />

                            <!--
                                What the pane says before anything is in it.

                                It replaces the two GitHub requests Sling used to seed on
                                every launch. Deleting those outright would have repeated
                                the collapsed-rail mistake one pane over: a panel that is
                                absent explains less than an empty one, and the sample was
                                doing real work, because chaining is the one Sling behaviour
                                that has to be seen rather than described. So the teaching
                                moves rather than going away - the example is still here,
                                one quiet click away, and it no longer arrives uninvited in
                                a window somebody opened to write their own request.

                                Laid out below the first line so the caret is never behind
                                it, and hit-testable only on the buttons, so clicking the
                                pane still puts the caret in the document.
                            -->
                            <StackPanel x:Name="EmptyDocument"
                                        Margin="14,44,14,14"
                                        VerticalAlignment="Top">
                                <TextBlock FontSize="12"
                                           IsHitTestVisible="False"
                                           Opacity="0.75"
                                           Text="Nothing open"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           IsHitTestVisible="False"
                                           Opacity="0.45"
                                           Text="A request is a document, not a form. Type a method and a URL here, or start from one of these."
                                           TextWrapping="Wrap" />

                                <ui:Button Margin="0,14,0,0"
                                           Appearance="Primary"
                                           Click="OnOpenFolderClicked"
                                           Content="Open a folder"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Style="{StaticResource RailActionButtonStyle}" />
                                <ui:Button Margin="0,6,0,0"
                                           Click="OnNewDocument"
                                           Content="New request file"
                                           Icon="{ui:SymbolIcon DocumentAdd24}"
                                           Style="{StaticResource RailActionButtonStyle}" />
                                <ui:Button Margin="0,6,0,0"
                                           Click="OnPasteCurlClicked"
                                           Content="Paste a curl command"
                                           Icon="{ui:SymbolIcon ClipboardPaste24}"
                                           Style="{StaticResource RailActionButtonStyle}" />

                                <!--
                                    Quieter than the three above, and deliberately so: it is
                                    the one button here that puts text nobody typed into the
                                    buffer, which is what the seeded sample did wrong.
                                -->
                                <TextBlock Margin="0,16,0,0"
                                           FontSize="11"
                                           Opacity="0.45"
                                           Text="Chaining is easier seen than described."
                                           TextWrapping="Wrap" />
                                <ui:HyperlinkButton x:Name="LoadExampleButton"
                                                    Margin="0,2,0,0"
                                                    Padding="0,2"
                                                    HorizontalAlignment="Left"
                                                    Click="OnLoadExampleClicked"
                                                    Content="Load the example"
                                                    FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <!--
                    The response side. DockPanel, and the declaration order is a priority
                    order: WPF never compresses an Auto region, so whatever is declared last
                    is what gets squeezed. The body must be the thing that shrinks.
                -->
                <DockPanel Grid.Column="2">
                    <!--
                        The exchange picker sits beside the label and appears only when a
                        chain actually ran. Sling sends requests on the user's behalf to
                        satisfy a {{name.response…}} reference, and a tool that makes network
                        calls nobody asked for has to show them - each one is selectable here
                        and lands in the buffer like any other.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource PaneHeaderStyle}"
                                   Text="RESPONSE" />

                        <!--
                            The status, coloured by class. It is the first thing anybody
                            looks for after a send and it used to be the third field of a
                            grey run-on line in the status bar. Colours come from
                            StatusPalette, which holds them to the same contrast floor as
                            everything else on this surface.
                        -->
                        <Border x:Name="StatusPill"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Style="{StaticResource StatusPillStyle}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusPillText"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>

                        <ComboBox x:Name="ExchangePicker"
                                  Grid.Column="2"
                                  Margin="12,0,0,0"
                                  Padding="8,2"
                                  HorizontalAlignment="Left"
                                  FontSize="12"
                                  SelectionChanged="OnExchangeSelected"
                                  Visibility="Collapsed" />
                    </Grid>

                    <Border Style="{StaticResource PaneBorderStyle}">
                        <DockPanel>
                            <!--
                                What was actually sent, and where it ended up if a redirect
                                moved it. A read-only TextBox rather than a TextBlock because
                                a URL in a debugging tool exists to be copied.
                            -->
                            <TextBox x:Name="RequestLine"
                                     Margin="10,10,10,0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     DockPanel.Dock="Top"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Visibility="Collapsed" />

                            <!--
                                Headers, collapsed. They matter often enough to keep one click
                                away and rarely enough that opening on them would push the body
                                below the fold on every send.
                            -->
                            <Expander x:Name="HeadersExpander"
                                      Margin="10,8,10,0"
                                      DockPanel.Dock="Top"
                                      FontSize="12"
                                      Visibility="Collapsed">
                                <TextBox x:Name="HeadersText"
                                         MaxHeight="180"
                                         Margin="0,6,0,0"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         HorizontalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </Expander>

                            <!--
                                The body, and only the body. Everything above this is the
                                reason: until M2 the pane held one rendered transcript, which
                                cannot be highlighted, folded or transformed without the
                                grammar colouring the headers and the transform being handed a
                                document that is mostly not the thing being transformed.
                            -->
                            <avalon:TextEditor x:Name="ResponsePane"
                                               IsReadOnly="True"
                                               Style="{StaticResource PaneEditorStyle}" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!--
            DockPanel, not Grid. WPF never compresses an Auto column, so a status bar
            built from Auto columns pushes its right-hand content off screen at narrow
            widths - the bug Etch shipped and had to fix. DockPanel declaration order is
            a priority order, and the fill child's arranged width does not depend on its
            own content, which is what makes it stable rather than merely better.
        -->
        <DockPanel Grid.Row="3" Margin="14,0,14,10" LastChildFill="True">
            <TextBlock x:Name="StatusRight"
                       Margin="12,0,0,0"
                       DockPanel.Dock="Right"
                       FontSize="12"
                       Opacity="0.5" />

            <!--
                The one diagnostic that was always a dead end, given somewhere to go. It
                names a variable, names the three places a value could come from, and used
                to be able to reach none of them - so the fix was always: read it, leave
                Sling, guess the shape of the file, come back.
            -->
            <ui:HyperlinkButton x:Name="StatusAction"
                                Margin="12,0,0,0"
                                Padding="0,2"
                                Click="OnStatusAction"
                                DockPanel.Dock="Right"
                                FontSize="12"
                                Visibility="Collapsed" />
            <TextBlock x:Name="StatusLeft"
                       FontSize="12"
                       Opacity="0.6"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!--
            The unsaved-changes question, and the last MessageBox in the application.

            A MessageBox is the operating system's dialog, not this one's: a white title bar
            with its own minimise glyphs, a yellow warning triangle, and three buttons
            labelled Yes, No and Cancel. Beside a Mica window whose two other modals are
            in-window cards it read as a different program - and Yes/No/Cancel makes the
            reader translate "No" into "throw my work away", which is the one answer here that
            cannot be undone. The buttons now name what they do.
        -->
        <Grid x:Name="ConfirmOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource OverlayScrimBrush}"
              Visibility="Collapsed">
            <Border x:Name="ConfirmCard"
                    Width="420"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle"
                               Margin="0,0,0,4"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Unsaved changes" />

                    <!--
                        Not SettingsHintStyle, which is 0.45 opacity. That is right for a note
                        under a control the user is already looking at, and wrong here: this
                        line is the question, and one of the three answers to it cannot be
                        undone.
                    -->
                    <TextBlock x:Name="ConfirmHint"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Opacity="0.85"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Click="OnConfirmCancel"
                                   Content="Cancel" />
                        <ui:Button Margin="0,0,8,0"
                                   Click="OnConfirmDiscard"
                                   Content="Discard" />
                        <ui:Button x:Name="ConfirmSaveButton"
                                   Appearance="Primary"
                                   Click="OnConfirmSave"
                                   Content="Save" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            The one thing creating a collection needs that a rail cannot express: a name.
            An overlay rather than a dialog window, for the same reasons the settings panel
            is one - no second set of chrome, no second theme to keep in step, and Escape
            closes it the way Escape closes everything else here.
        -->
        <Grid x:Name="NamePromptOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource OverlayScrimBrush}"
              Visibility="Collapsed">
            <Border x:Name="NamePromptCard"
                    Width="400"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="NamePromptTitle"
                               Margin="0,0,0,4"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="NamePromptHint" Style="{StaticResource SettingsHintStyle}" />

                    <TextBox x:Name="NamePromptBox"
                             Margin="0,16,0,0"
                             KeyDown="OnNamePromptKey"
                             MaxLength="200" />

                    <TextBlock x:Name="NamePromptError"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="#F48771"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Click="OnNamePromptCancel"
                                   Content="Cancel" />
                        <ui:Button Appearance="Primary"
                                   Click="OnNamePromptAccept"
                                   Content="Create" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Settings, as an overlay over the whole window rather than a second Window.
            A dialog would need its own chrome, its own backdrop and its own theme
            plumbing to look like the application it belongs to; this needs none of it,
            and Escape closes it the way Escape closes everything else here.

            RowSpan covers the title bar too: a modal thing that leaves the title bar
            live invites a click that does nothing.
        -->
        <Grid x:Name="SettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource OverlayScrimBrush}"
              Visibility="Collapsed">
            <Border x:Name="SettingsCard"
                    Width="440"
                    MaxHeight="640"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <!--
                    DockPanel so the heading and the Close button are outside the scroll
                    region. They were inside it, which put Close below the fold on a 640 px
                    card - a modal panel whose only visible way out was a chord. Found by
                    looking at it; nothing could have asserted it.
                -->
                <DockPanel>
                    <TextBlock Margin="0,0,0,4"
                               DockPanel.Dock="Top"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Settings" />
                    <TextBlock x:Name="SettingsPath"
                               Margin="0,0,0,10"
                               DockPanel.Dock="Top"
                               FontSize="11"
                               Opacity="0.5"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button Margin="0,20,0,0"
                               HorizontalAlignment="Right"
                               Appearance="Primary"
                               Click="OnCloseSettings"
                               Content="Close"
                               DockPanel.Dock="Bottom" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!--
                            The right margin is the scrollbar's lane. WPF-UI draws it inside
                            the viewport, so without this it sits on top of the number boxes
                            and clips the hint text under them.
                        -->
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Request timeout (seconds)" />
                            <ui:NumberBox x:Name="TimeoutBox"
                                          MaxDecimalPlaces="0"
                                          Maximum="3600"
                                          Minimum="1"
                                          ValueChanged="OnSettingChanged" />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Largest response held (MB)" />
                            <ui:NumberBox x:Name="BodyCapBox"
                                          MaxDecimalPlaces="0"
                                          Maximum="512"
                                          Minimum="1"
                                          ValueChanged="OnSettingChanged" />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Redirects followed" />
                            <ui:NumberBox x:Name="RedirectsBox"
                                          MaxDecimalPlaces="0"
                                          Maximum="20"
                                          Minimum="0"
                                          ValueChanged="OnSettingChanged" />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Cookies" />
                            <ui:ToggleSwitch x:Name="CookiesToggle"
                                             Checked="OnSettingToggled"
                                             Content="Store and replay cookies"
                                             Unchecked="OnSettingToggled" />
                            <TextBlock Style="{StaticResource SettingsHintStyle}"
                                       Text="One jar per environment, in memory only. Nothing is written to disk." />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Access tokens" />
                            <ui:ToggleSwitch x:Name="RememberTokensToggle"
                                             Checked="OnSettingToggled"
                                             Content="Remember them across restarts"
                                             Unchecked="OnSettingToggled" />
                            <TextBlock Style="{StaticResource SettingsHintStyle}"
                                       Text="Encrypted with Windows data protection under your account, scoped per folder and environment, and holding no client secret. Switching this off deletes the ones already stored." />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="History" />
                            <ui:ToggleSwitch x:Name="HistoryToggle"
                                             Checked="OnSettingToggled"
                                             Content="Record requests locally"
                                             Unchecked="OnSettingToggled" />
                            <TextBlock Style="{StaticResource SettingsHintStyle}"
                                       Text="Credentials are removed before anything is written, and no body is stored at all. Ctrl+H shows it." />

                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="History entries kept" />
                            <ui:NumberBox x:Name="HistoryEntriesBox"
                                          MaxDecimalPlaces="0"
                                          Maximum="10000"
                                          Minimum="10"
                                          ValueChanged="OnSettingChanged" />

                            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0"
                                           Click="OnShowCookies"
                                           Content="Show cookies" />
                                <ui:Button Margin="0,0,8,0"
                                           Click="OnClearCookies"
                                           Content="Clear cookies" />
                                <ui:Button Click="OnClearHistory" Content="Clear history" />
                            </StackPanel>

                            <!--
                                Stated rather than offered. Sling.md §5.3 allows a TLS bypass
                                only per request and only with loud indication, so there is no
                                global switch here to find - and saying why is better than
                                leaving someone to hunt for one.
                            -->
                            <TextBlock Margin="0,20,0,0"
                                       FontSize="11"
                                       Opacity="0.5"
                                       Text="Certificate validation is always on and has no setting. A global bypass gets switched on once and left on."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!--
            Environments and secrets, as a card.

            Until this existed a credential could not be created from inside Sling at all:
            docs/environments.md said in plain words that nothing here wrote the secrets
            file, so the only way to get a bearer token into a request was to leave the
            application and hand-write JSON whose environment names had to match another
            file that had also been hand-written.

            The files stay the truth. This writes a value into one of them and then has no
            further role - there is no store and nothing Sling remembers. The toggle is the
            whole security design: it decides which of the two files the value lands in, and
            turning it on creates the gitignored one together with its .gitignore entry.
        -->
        <Grid x:Name="EnvironmentsOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource OverlayScrimBrush}"
              Visibility="Collapsed">
            <Border x:Name="EnvironmentsCard"
                    Width="520"
                    MaxHeight="660"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <!--
                    DockPanel so the heading and the Close button stay outside the scroll
                    region, for the reason the settings card learned the hard way: inside it
                    they go below the fold on a short window, and the only way out of a modal
                    becomes a chord.
                -->
                <DockPanel>
                    <TextBlock Margin="0,0,0,4"
                               DockPanel.Dock="Top"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Environments" />
                    <TextBlock x:Name="EnvironmentsPath"
                               Margin="0,0,0,12"
                               DockPanel.Dock="Top"
                               FontSize="11"
                               Opacity="0.5"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button Margin="0,20,0,0"
                               HorizontalAlignment="Right"
                               Appearance="Primary"
                               Click="OnCloseEnvironments"
                               Content="Close"
                               DockPanel.Dock="Bottom" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="EnvironmentsPicker"
                                  Grid.Column="0"
                                  Padding="8,4"
                                  FontSize="12"
                                  SelectionChanged="OnEnvironmentsEnvironmentChanged" />

                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Click="OnNewEnvironment"
                                   Content="New environment"
                                   FontSize="12" />
                    </Grid>

                    <!--
                        Stated once, above the list, rather than repeated as a tooltip per
                        row. Which file a value lives in is the only thing about these two
                        files that has to be understood, and it is the thing a screenshot of
                        this card should carry.
                    -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                        <!--
                            Off by default, and that is the point of it. The people who open
                            this card are the people who put a live token in it, and a panel
                            is a place a screenshot comes from - so a secret is a row of dots
                            until somebody says otherwise.
                        -->
                        <ui:ToggleSwitch x:Name="EnvironmentsReveal"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Top"
                                         Checked="OnEnvironmentsRevealToggled"
                                         Content="Show secrets"
                                         DockPanel.Dock="Right"
                                         Unchecked="OnEnvironmentsRevealToggled" />

                        <TextBlock Style="{StaticResource SettingsHintStyle}"
                                   Text="Values marked secret go to http-client.private.env.json, which is gitignored. Everything else goes to http-client.env.json, which is meant to be committed." />
                    </DockPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,6"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"
                                   Text="ADD OR CHANGE A VALUE" />

                        <ui:TextBox x:Name="EnvironmentsName"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    MaxLength="128"
                                    PlaceholderText="name"
                                    TextChanged="OnEnvironmentsFormChanged" />

                        <!--
                            The toggle sits beside the name rather than under the value,
                            because it is a question about the name: it decides which file
                            this variable belongs in, and for a variable that already exists
                            the answer is settled and the control is disabled.
                        -->
                        <ui:ToggleSwitch x:Name="EnvironmentsSecret"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Checked="OnEnvironmentsSecretToggled"
                                         Content="Secret"
                                         Unchecked="OnEnvironmentsSecretToggled" />

                        <ui:TextBox x:Name="EnvironmentsValue"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,8,8,0"
                                    KeyDown="OnEnvironmentsValueKey"
                                    PlaceholderText="value"
                                    TextChanged="OnEnvironmentsFormChanged" />

                        <ui:Button x:Name="EnvironmentsSaveButton"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,8,0,0"
                                   MinWidth="92"
                                   Appearance="Primary"
                                   Click="OnEnvironmentsSave"
                                   Content="Save" />

                        <TextBlock x:Name="EnvironmentsError"
                                   Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="#F48771"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Border Margin="0,10,0,0" Style="{StaticResource PaneBorderStyle}">
                        <Grid>
                            <TextBlock x:Name="EnvironmentsEmpty"
                                       Margin="14,16,14,14"
                                       FontSize="11"
                                       Opacity="0.45"
                                       Text="This environment has no variables yet. Add one below - a base URL, a client id, a token."
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top" />

                            <ScrollViewer Padding="4" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="EnvironmentsList" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                A row is a button, because the one thing to do
                                                with an existing value is edit it, and making
                                                the row itself the affordance saves an Edit
                                                control per row that would say the same.
                                            -->
                                            <ui:Button Margin="0,1"
                                                       Padding="8,5"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Left"
                                                       Appearance="Transparent"
                                                       Click="OnEnvironmentsRowClicked"
                                                       Tag="{Binding}"
                                                       ToolTip="{Binding Hint}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               FontSize="11"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               FontSize="11"
                                                               Opacity="0.6"
                                                               Text="{Binding Display}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Opacity="0.5"
                                                               Text="{Binding FileLabel}" />
                                                </Grid>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!--
            The auth panel, and it is the item that changes how Sling feels.

            Postman's Auth tab is the most used screen in that product, and there is no
            reason a text-first tool cannot have one - as long as what it edits is the text.
            Every field here writes directives and headers into the open .http document and
            then gets out of the way. Close the panel and what is left is a file a colleague
            can review, which is the whole difference from the version that writes into a
            database.

            A credential typed into it never lands in the document. It goes to
            http-client.private.env.json and the document gets a {{reference}} - the
            importer's rule, applied to hand-authoring.
        -->
        <Grid x:Name="AuthOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource OverlayScrimBrush}"
              Visibility="Collapsed">
            <Border x:Name="AuthCard"
                    Width="520"
                    MaxHeight="680"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <DockPanel>
                    <TextBlock Margin="0,0,0,4"
                               DockPanel.Dock="Top"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Auth" />
                    <TextBlock x:Name="AuthRequestLabel"
                               Margin="0,0,0,2"
                               DockPanel.Dock="Top"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="11"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis" />

                    <!--
                        Where the credential comes from, named with its line. This is the
                        sentence the panel exists for: it used to take reading the document,
                        one environment file and the other one to arrive at.
                    -->
                    <TextBlock x:Name="AuthOriginLabel"
                               Margin="0,8,0,0"
                               DockPanel.Dock="Top"
                               FontSize="12"
                               Opacity="0.85"
                               TextWrapping="Wrap" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock x:Name="AuthResolution"
                                   MaxWidth="380"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Opacity="0.55"
                                   TextWrapping="Wrap" />
                        <ui:HyperlinkButton x:Name="AuthDefineButton"
                                            Margin="6,2,0,0"
                                            Padding="0,2"
                                            Click="OnAuthDefineVariable"
                                            Content="Define it"
                                            FontSize="11"
                                            Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Click="OnCloseAuth"
                                   Content="Close" />
                        <ui:Button x:Name="AuthApplyButton"
                                   MinWidth="92"
                                   Appearance="Primary"
                                   Click="OnAuthApply"
                                   Content="Apply" />
                    </StackPanel>

                    <TextBlock x:Name="AuthError"
                               Margin="0,10,0,0"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Foreground="#F48771"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                        <!-- The right margin is the scrollbar's lane, as on the settings card. -->
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Kind" />
                            <ComboBox x:Name="AuthSchemePicker"
                                      Padding="8,4"
                                      FontSize="12"
                                      SelectionChanged="OnAuthSchemeChanged" />

                            <StackPanel x:Name="AuthNoneFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsHintStyle}"
                                           Text="Applying this removes the Authorization header or the @auth block from this request. Nothing else in it is touched." />
                            </StackPanel>

                            <StackPanel x:Name="AuthUnrecognizedFields" Visibility="Collapsed">
                                <TextBlock x:Name="AuthUnrecognizedNote"
                                           Style="{StaticResource SettingsHintStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="AuthBearerFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Token" />
                                <ui:TextBox x:Name="AuthBearerValue"
                                            PlaceholderText="{}{{token}}, or paste the token itself"
                                            TextChanged="OnAuthFieldChanged" />
                            </StackPanel>

                            <StackPanel x:Name="AuthBasicFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="User" />
                                <ui:TextBox x:Name="AuthBasicUser" TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Password" />
                                <ui:PasswordBox x:Name="AuthBasicPassword" PasswordChanged="OnAuthPasswordChanged" />

                                <TextBlock Style="{StaticResource SettingsHintStyle}"
                                           Text="A Basic header carries base64 of user:password. Sling encodes it, puts the encoded value in the secrets file, and writes the reference." />
                            </StackPanel>

                            <StackPanel x:Name="AuthApiKeyFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Header" />
                                <ui:TextBox x:Name="AuthApiKeyHeader"
                                            PlaceholderText="X-API-Key"
                                            TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Key" />
                                <ui:TextBox x:Name="AuthApiKeyValue"
                                            PlaceholderText="{}{{api_key}}, or paste the key itself"
                                            TextChanged="OnAuthFieldChanged" />
                            </StackPanel>

                            <!--
                                The two directives the browser flow adds. Shown above the
                                token URL because that is the order the flow happens in: the
                                browser goes to one and comes back to the other, and only
                                then is there a code to exchange.
                            -->
                            <StackPanel x:Name="AuthBrowserFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Authorize URL" />
                                <ui:TextBox x:Name="AuthAuthorizeUrl"
                                            PlaceholderText="{}{{auth_base}}/authorize"
                                            TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Redirect back to" />
                                <ui:TextBox x:Name="AuthRedirectUri" TextChanged="OnAuthFieldChanged" />
                                <TextBlock Style="{StaticResource SettingsHintStyle}"
                                           Text="A loopback address on this machine, which Sling listens on for the moment the browser comes back. It has to be registered with your identity provider exactly as written, and that is the one part Sling cannot do for you." />
                            </StackPanel>

                            <StackPanel x:Name="AuthGrantFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Token URL" />
                                <ui:TextBox x:Name="AuthTokenUrl"
                                            PlaceholderText="{}{{auth_base}}/oauth2/token"
                                            TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Client id" />
                                <ui:TextBox x:Name="AuthClientId" TextChanged="OnAuthFieldChanged" />

                                <TextBlock x:Name="AuthClientSecretLabel"
                                           Style="{StaticResource SettingsLabelStyle}"
                                           Text="Client secret" />
                                <ui:TextBox x:Name="AuthClientSecret"
                                            PlaceholderText="{}{{client_secret}}, or paste the secret itself"
                                            TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Scope" />
                                <ui:TextBox x:Name="AuthScope"
                                            PlaceholderText="space separated, or leave empty"
                                            TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Audience" />
                                <ui:TextBox x:Name="AuthAudience"
                                            PlaceholderText="only if your provider asks for one"
                                            TextChanged="OnAuthFieldChanged" />

                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Client credentials go in" />
                                <ComboBox x:Name="AuthPlacement"
                                          Padding="8,4"
                                          FontSize="12" />
                            </StackPanel>

                            <!--
                                Shown only when what was typed is a credential rather than a
                                reference. It is the one place the panel writes somewhere
                                other than the document, so it says where, by name, before it
                                does it.
                            -->
                            <StackPanel x:Name="AuthStoreFields" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Store it as" />
                                <ui:TextBox x:Name="AuthStoreName"
                                            MaxLength="128"
                                            TextChanged="OnAuthFieldChanged" />
                                <TextBlock x:Name="AuthStoreHint"
                                           Style="{StaticResource SettingsHintStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!--
            Every access token this session, by the grant that produced it.

            Never a token value. The grant identity and the clock are what answer "why did
            that 401" - a stale token, a wrong scope, and a token fetched against the other
            environment all produce the same status and are told apart only here.
        -->
        <Grid x:Name="TokensOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Background="{StaticResource OverlayScrimBrush}"
              Visibility="Collapsed">
            <Border x:Name="TokensCard"
                    Width="520"
                    MaxHeight="560"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <DockPanel>
                    <TextBlock Margin="0,0,0,4"
                               DockPanel.Dock="Top"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Access tokens" />
                    <TextBlock x:Name="TokensSubtitle"
                               Margin="0,0,0,12"
                               DockPanel.Dock="Top"
                               FontSize="11"
                               Opacity="0.5"
                               TextWrapping="Wrap" />

                    <ui:Button Margin="0,20,0,0"
                               HorizontalAlignment="Right"
                               Appearance="Primary"
                               Click="OnCloseTokens"
                               Content="Close"
                               DockPanel.Dock="Bottom" />

                    <ui:Button Margin="0,14,0,0"
                               HorizontalAlignment="Left"
                               Click="OnForgetTokens"
                               Content="Forget them"
                               DockPanel.Dock="Bottom"
                               ToolTip="Drops every cached token. The next send fetches a new one." />

                    <Border Style="{StaticResource PaneBorderStyle}">
                        <Grid>
                            <TextBlock x:Name="TokensEmpty"
                                       Margin="14,16,14,14"
                                       VerticalAlignment="Top"
                                       FontSize="11"
                                       Opacity="0.45"
                                       Text="No token has been fetched this session. One appears here the first time a request with a '# @auth oauth2' block is sent."
                                       TextWrapping="Wrap" />

                            <ScrollViewer Padding="4" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TokensList" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,7">
                                                <TextBlock FontFamily="Cascadia Code, Consolas, Courier New"
                                                           FontSize="11"
                                                           Text="{Binding Grant}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Opacity="0.55"
                                                           Text="{Binding Endpoint}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Opacity="0.45"
                                                           Text="{Binding Clock}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
