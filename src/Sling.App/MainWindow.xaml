<ui:FluentWindow x:Class="Sling.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
                 Title="Sling"
                 Width="1180"
                 Height="760"
                 MinWidth="520"
                 MinHeight="360"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The window's Title carries the open file and its dirty marker; one source. -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

        <!--
            DockPanel, not a fourth Grid column. WPF never compresses an Auto column, so a
            file rail in one would push the response pane off screen at narrow widths —
            the bug Etch shipped in its status bar and had to rebuild. A DockPanel gives
            its fill child the remainder clamped at zero instead, so the rail takes its
            width and the panes shrink.
        -->
        <DockPanel Grid.Row="1" Margin="12,0,12,8" LastChildFill="True">
            <!--
                The workspace: the .http files in the folder that is open. Shown only when
                there is one, because with no folder open it would be an empty box
                explaining nothing.
            -->
            <DockPanel x:Name="FilesRail"
                       Width="190"
                       Margin="0,0,10,0"
                       DockPanel.Dock="Left"
                       Visibility="Collapsed">
                <TextBlock x:Name="FilesLabel"
                           Margin="2,0,0,6"
                           DockPanel.Dock="Top"
                           FontSize="12"
                           Opacity="0.6"
                           Text="FILES"
                           TextTrimming="CharacterEllipsis" />
                <Border Style="{StaticResource PaneBorderStyle}">
                    <ListBox x:Name="FileList"
                             Padding="4"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="12"
                             SelectionChanged="OnFileSelected" />
                </Border>
            </DockPanel>

            <!--
                Two panes: the request document on the left, the response on the right.
                A GridSplitter rather than a fixed ratio — a response is usually wider
                than the request that produced it, and the split people want depends on
                the API, not on a designer's guess.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <!--
                        The label names the open file, and the environment picker sits
                        beside it: which environment is selected changes what every
                        {{variable}} in this document resolves to, so it belongs against
                        the document rather than in a menu.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="RequestLabel"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.6"
                                   Text="REQUEST"
                                   TextTrimming="CharacterEllipsis" />

                        <ComboBox x:Name="EnvironmentPicker"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Padding="8,2"
                                  FontSize="12"
                                  Visibility="Collapsed"
                                  SelectionChanged="OnEnvironmentSelected" />
                    </Grid>

                    <Border Style="{StaticResource PaneBorderStyle}">
                        <avalon:TextEditor x:Name="RequestPane"
                                           Style="{StaticResource PaneEditorStyle}"
                                           ShowLineNumbers="True" />
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <!--
                    The response side. DockPanel, and the declaration order is a priority
                    order: WPF never compresses an Auto region, so whatever is declared last
                    is what gets squeezed. The body must be the thing that shrinks.
                -->
                <DockPanel Grid.Column="2">
                    <!--
                        The exchange picker sits beside the label and appears only when a
                        chain actually ran. Sling sends requests on the user's behalf to
                        satisfy a {{name.response…}} reference, and a tool that makes network
                        calls nobody asked for has to show them — each one is selectable here
                        and lands in the buffer like any other.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.6"
                                   Text="RESPONSE" />

                        <ComboBox x:Name="ExchangePicker"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Padding="8,2"
                                  HorizontalAlignment="Left"
                                  FontSize="12"
                                  Visibility="Collapsed"
                                  SelectionChanged="OnExchangeSelected" />
                    </Grid>

                    <Border Style="{StaticResource PaneBorderStyle}">
                        <DockPanel>
                            <!--
                                What was actually sent, and where it ended up if a redirect
                                moved it. A read-only TextBox rather than a TextBlock because
                                a URL in a debugging tool exists to be copied.
                            -->
                            <TextBox x:Name="RequestLine"
                                     DockPanel.Dock="Top"
                                     Margin="10,10,10,0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Visibility="Collapsed" />

                            <!--
                                Headers, collapsed. They matter often enough to keep one click
                                away and rarely enough that opening on them would push the body
                                below the fold on every send.
                            -->
                            <Expander x:Name="HeadersExpander"
                                      DockPanel.Dock="Top"
                                      Margin="10,8,10,0"
                                      FontSize="12"
                                      Visibility="Collapsed">
                                <TextBox x:Name="HeadersText"
                                         Margin="0,6,0,0"
                                         MaxHeight="180"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Expander>

                            <!--
                                The body, and only the body. Everything above this is the
                                reason: until M2 the pane held one rendered transcript, which
                                cannot be highlighted, folded or transformed without the
                                grammar colouring the headers and the transform being handed a
                                document that is mostly not the thing being transformed.
                            -->
                            <avalon:TextEditor x:Name="ResponsePane"
                                               Style="{StaticResource PaneEditorStyle}"
                                               IsReadOnly="True" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!--
            DockPanel, not Grid. WPF never compresses an Auto column, so a status bar
            built from Auto columns pushes its right-hand content off screen at narrow
            widths — the bug Etch shipped and had to fix. DockPanel declaration order is
            a priority order, and the fill child's arranged width does not depend on its
            own content, which is what makes it stable rather than merely better.
        -->
        <DockPanel Grid.Row="2" Margin="14,0,14,10" LastChildFill="True">
            <TextBlock x:Name="StatusRight"
                       DockPanel.Dock="Right"
                       Margin="12,0,0,0"
                       FontSize="12"
                       Opacity="0.5" />
            <TextBlock x:Name="StatusLeft"
                       FontSize="12"
                       Opacity="0.6"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!--
            Settings, as an overlay over the whole window rather than a second Window.
            A dialog would need its own chrome, its own backdrop and its own theme
            plumbing to look like the application it belongs to; this needs none of it,
            and Escape closes it the way Escape closes everything else here.

            RowSpan covers the title bar too: a modal thing that leaves the title bar
            live invites a click that does nothing.
        -->
        <Grid x:Name="SettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="#B0000000"
              Visibility="Collapsed">
            <Border Width="440"
                    MaxHeight="640"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource PaneBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Settings" />
                        <TextBlock x:Name="SettingsPath"
                                   Margin="0,0,0,10"
                                   FontSize="11"
                                   Opacity="0.5"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Request timeout (seconds)" />
                        <ui:NumberBox x:Name="TimeoutBox"
                                      MaxDecimalPlaces="0"
                                      Maximum="3600"
                                      Minimum="1"
                                      ValueChanged="OnSettingChanged" />

                        <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Largest response held (MB)" />
                        <ui:NumberBox x:Name="BodyCapBox"
                                      MaxDecimalPlaces="0"
                                      Maximum="512"
                                      Minimum="1"
                                      ValueChanged="OnSettingChanged" />

                        <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Redirects followed" />
                        <ui:NumberBox x:Name="RedirectsBox"
                                      MaxDecimalPlaces="0"
                                      Maximum="20"
                                      Minimum="0"
                                      ValueChanged="OnSettingChanged" />

                        <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="Cookies" />
                        <ui:ToggleSwitch x:Name="CookiesToggle"
                                         Checked="OnSettingToggled"
                                         Content="Store and replay cookies"
                                         Unchecked="OnSettingToggled" />
                        <TextBlock Style="{StaticResource SettingsHintStyle}"
                                   Text="One jar per environment, in memory only — nothing is written to disk." />

                        <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="History" />
                        <ui:ToggleSwitch x:Name="HistoryToggle"
                                         Checked="OnSettingToggled"
                                         Content="Record requests locally"
                                         Unchecked="OnSettingToggled" />
                        <TextBlock Style="{StaticResource SettingsHintStyle}"
                                   Text="Credentials are removed before anything is written, and no body is stored at all. Ctrl+H shows it." />

                        <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="History entries kept" />
                        <ui:NumberBox x:Name="HistoryEntriesBox"
                                      MaxDecimalPlaces="0"
                                      Maximum="10000"
                                      Minimum="10"
                                      ValueChanged="OnSettingChanged" />

                        <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Click="OnShowCookies"
                                       Content="Show cookies" />
                            <ui:Button Margin="0,0,8,0"
                                       Click="OnClearCookies"
                                       Content="Clear cookies" />
                            <ui:Button Click="OnClearHistory" Content="Clear history" />
                        </StackPanel>

                        <!--
                            Stated rather than offered. Sling.md §5.3 allows a TLS bypass
                            only per request and only with loud indication, so there is no
                            global switch here to find — and saying why is better than
                            leaving someone to hunt for one.
                        -->
                        <TextBlock Margin="0,20,0,0"
                                   FontSize="11"
                                   Opacity="0.5"
                                   Text="Certificate validation is always on and has no setting. A global bypass gets switched on once and left on."
                                   TextWrapping="Wrap" />

                        <ui:Button Margin="0,20,0,0"
                                   HorizontalAlignment="Right"
                                   Appearance="Primary"
                                   Click="OnCloseSettings"
                                   Content="Close" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
