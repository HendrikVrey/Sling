<Project>

  <!--
    Central package management. Versions live here only; csproj files reference
    packages by name with no Version attribute.

    Versions carried over from Etch, where they are known-good against
    net10.0-windows (verified there 2026-07-29). Reusing them rather than taking
    whatever is newest is deliberate: Etch already paid for the compatibility
    knowledge below.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <!-- WPF-UI 4.3.0 ships a native net10.0-windows7.0 target. -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <!-- AvalonEdit 6.3.1.120 tops out at net8.0-windows7.0; net10.0-windows
         consumes that asset compatibly. -->
    <PackageVersion Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup Label="Etch">
    <!--
      The transform engine, consumed as a package from a private feed rather than as
      a submodule or a copied folder. Not on nuget.org and never will be - see
      NuGet.config and docs/etch-core-package.md for why, and local-feed/README.md
      for how to restore it without credentials.

      Pinned exactly. A folder source matches on version, so a floating range here
      would turn "did the build pick up the pack I just made?" into a question with
      no visible answer.
    -->
    <PackageVersion Include="Etch.Core" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
